{
  "name": "btcpayserver-plugin-sites",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:events": "npm run dev --workspace @makepay/events-site",
    "dev:downloads": "npm run dev --workspace @makepay/downloads-site",
    "build": "npm run build --workspaces --if-present",
    "build:events": "npm run build --workspace @makepay/events-site",
    "build:downloads": "npm run build --workspace @makepay/downloads-site",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8.5.10"
  }
}
